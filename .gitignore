########################################
# FundChain Root
########################################


########################################
# Frontend (React + Vite)
########################################

# Node modules
Frontend/node_modules/

# Vite build output
Frontend/dist/

# Environment variables
Frontend/.env
Frontend/.env.local
Frontend/.env.development.local
Frontend/.env.production.local

# Vite cache
Frontend/.vite/


########################################
# Backend (Spring Boot + Gradle)
########################################

# Gradle build files
Backend/build/

# Gradle cache
Backend/.gradle/

# Gradle wrapper generated files (keep wrapper jar)
!Backend/gradle/wrapper/gradle-wrapper.jar


# Spring Boot generated files
Backend/out/


# Logs
Backend/*.log
Backend/logs/


########################################
# Database / Local Settings
########################################

# H2 database (if used locally)
*.mv.db
*.trace.db

# Local DB / Secret configuration
application-local.yml
application-secret.yml
application-local.properties
application-secret.properties
**/application-secret.properties
**/application-local.properties

# Environment files
*.env


########################################
# IDE
########################################

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr


# Eclipse / STS
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache

# VS Code
.vscode/


########################################
# OS
########################################

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store


########################################
# Java
########################################

# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear

# JVM crash logs
hs_err_pid*


########################################
# Node
########################################

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


########################################
# Temporary files
########################################

*.tmp
*.temp
*.bak
*.swp


########################################
